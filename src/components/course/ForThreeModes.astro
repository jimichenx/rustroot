---
/**
 * 9.1「for 循环与遍历三件套」分步配图：
 * 顶部常驻：语言内核唯一的机械展开公式。
 * 下方三行（3 步分步对比）：&Vec<String>、&mut Vec<String>、Vec<String> 三个独立具体类型，
 * 各自匹配不同的 impl IntoIterator，由关联类型 type Item 锁定左边 s 的类型与原集合状态。
 * 样式复用 src/styles/diagrams.css，不写组件内 <style>。
 */
import { SITE_LOCALE } from '../../config/site';
import FigureControls from './FigureControls.astro';

const en = SITE_LOCALE === 'en';
const t = en
	? {
			caption:
				'The compiler kernel performs only one mechanical expansion: IntoIterator::into_iter(expr). Because &Vec<T>, &mut Vec<T>, and Vec<T> are three distinct concrete types, each matches its own impl IntoIterator, where type Item locks in the type of s.',
			title: 'One mechanical expansion, three independent IntoIterator implementations',
			desc: 'Top banner: The compiler expands `for s in expr` into `let mut iter = IntoIterator::into_iter(expr)` and `while let Some(s) = iter.next()`. Below are three rows: Row 1 (`for s in &names`) passes `Self = &Vec<String>`, matches `impl IntoIterator for &Vec<T>` with `type Item = &String`, giving `s: &String` while `names` stays intact. Row 2 (`for s in &mut names`) passes `Self = &mut Vec<String>`, matches `impl IntoIterator for &mut Vec<T>` with `type Item = &mut String`, giving `s: &mut String` for in-place mutation while `names` stays valid. Row 3 (`for s in names`) passes `Self = Vec<String>`, matches `impl IntoIterator for Vec<T>` with `type Item = String`, moving elements to `s: String` and leaving `names` moved (E0382).',
			bannerTitle: 'Compiler kernel · single mechanical desugaring',
			bannerC1: 'for s in expr',
			bannerC2: 'IntoIterator::into_iter(expr)',
			bannerC3: 'while let Some(s) = iter.next()',
			col1: '1. Input Self concrete type',
			col2: '2. Matched impl IntoIterator',
			col3: '3. Bound s & collection state',
			r1Code: 'for s in &names',
			r1Self: 'Self = &Vec<String>',
			r1Impl: 'impl IntoIterator for &Vec<T>',
			r1Item: 'type Item = &String (calls .iter())',
			r1Out: 's: &String',
			r1State: 'shared borrow · names stays valid',
			r2Code: 'for s in &mut names',
			r2Self: 'Self = &mut Vec<String>',
			r2Impl: 'impl IntoIterator for &mut Vec<T>',
			r2Item: 'type Item = &mut String (.iter_mut())',
			r2Out: 's: &mut String',
			r2State: 'in-place mutation · names stays valid',
			r3Code: 'for s in names',
			r3Self: 'Self = Vec<String>',
			r3Impl: 'impl IntoIterator for Vec<T>',
			r3Item: 'type Item = String (takes buffer)',
			r3Out: 's: String',
			r3State: 'ownership moved · names invalid (E0382)',
			stepper: 'Steps',
			steps: [
				'shared borrow: for s in &names',
				'mutable borrow: for s in &mut names',
				'by-value move: for s in names',
			],
		}
	: {
			caption:
				'编译器内核只做一次机械展开 `IntoIterator::into_iter(expr)`；因为 `&Vec<T>`、`&mut Vec<T>`、`Vec<T>` 是三个独立的具体类型，各自匹配不同的 `impl IntoIterator`，由 `type Item` 锁定左边 `s` 的类型。',
			title: '同一次机械展开，三个独立类型匹配三份 IntoIterator 实现',
			desc: '顶部面板展示语言内核唯一的机械展开：`for s in expr` 展开为 `IntoIterator::into_iter(expr)` 与 `while let Some(s) = iter.next()`。下方三行对应三种遍历模式：第 1 行 `for s in &names` 传入 `Self = &Vec<String>`，匹配 `impl IntoIterator for &Vec<T>`（`type Item = &String`），产出 `s: &String`，`names` 原封保留；第 2 行 `for s in &mut names` 传入 `Self = &mut Vec<String>`，匹配 `impl IntoIterator for &mut Vec<T>`（`type Item = &mut String`），产出 `s: &mut String` 原地修改，`names` 保留；第 3 行 `for s in names` 传入 `Self = Vec<String>`，匹配 `impl IntoIterator for Vec<T>`（`type Item = String`），产出 `s: String`，`names` 移入失效（E0382）。',
			bannerTitle: '语言内核唯一动作 · 机械脱糖展开（不检查 & 或集合种类）',
			bannerC1: 'for s in expr',
			bannerC2: 'IntoIterator::into_iter(expr)',
			bannerC3: 'while let Some(s) = iter.next()',
			col1: '1. 传入的 Self 具体类型',
			col2: '2. 匹配的标准库实现与关联类型',
			col3: '3. 左边 s 的类型与原集合状态',
			r1Code: 'for s in &names',
			r1Self: 'Self = &Vec<String>',
			r1Impl: 'impl IntoIterator for &Vec<T>',
			r1Item: 'type Item = &String（调 .iter()）',
			r1Out: 's: &String',
			r1State: '只读借用元素 · names 原封保留',
			r2Code: 'for s in &mut names',
			r2Self: 'Self = &mut Vec<String>',
			r2Impl: 'impl IntoIterator for &mut Vec<T>',
			r2Item: 'type Item = &mut String（.iter_mut()）',
			r2Out: 's: &mut String',
			r2State: '原地修改元素 · names 保留所有权',
			r3Code: 'for s in names',
			r3Self: 'Self = Vec<String>',
			r3Impl: 'impl IntoIterator for Vec<T>',
			r3Item: 'type Item = String（接管堆缓冲）',
			r3Out: 's: String',
			r3State: '移出元素所有权 · names 失效 E0382',
			stepper: '步骤',
			steps: [
				'只读借用：for s in &names',
				'可变借用：for s in &mut names',
				'按值消耗：for s in names',
			],
		};

const rows = [
	{
		y: 120,
		code: t.r1Code,
		selfType: t.r1Self,
		implHead: t.r1Impl,
		itemLine: t.r1Item,
		outType: t.r1Out,
		state: t.r1State,
		consumed: false,
	},
	{
		y: 204,
		code: t.r2Code,
		selfType: t.r2Self,
		implHead: t.r2Impl,
		itemLine: t.r2Item,
		outType: t.r2Out,
		state: t.r2State,
		consumed: false,
	},
	{
		y: 288,
		code: t.r3Code,
		selfType: t.r3Self,
		implHead: t.r3Impl,
		itemLine: t.r3Item,
		outType: t.r3Out,
		state: t.r3State,
		consumed: true,
	},
];
---

<figure class="diagram" data-stepper>
	<figcaption>{t.caption}</figcaption>
	<svg viewBox="0 0 640 374" role="img" aria-labelledby="ftm-title ftm-desc">
		<title id="ftm-title">{t.title}</title>
		<desc id="ftm-desc">{t.desc}</desc>

		{/* 顶部常驻横幅：语言内核唯一的机械展开公式 */}
		<rect class="panel" x="16" y="14" width="608" height="68" rx="10"></rect>
		<text class="label" x="32" y="34">{t.bannerTitle}</text>

		<text class="code" x="88" y="62" text-anchor="middle">{t.bannerC1}</text>
		<path class="arrow" d="M 152 58 H 184" marker-end="url(#ftm-head)"></path>
		<text class="code" x="304" y="62" text-anchor="middle">{t.bannerC2}</text>
		<path class="arrow" d="M 424 58 H 452" marker-end="url(#ftm-head)"></path>
		<text class="code" x="536" y="62" text-anchor="middle">{t.bannerC3}</text>

		{/* 三栏列标题 */}
		<text class="edge-sub" x="98" y="106" text-anchor="middle">{t.col1}</text>
		<text class="edge-sub" x="314" y="106" text-anchor="middle">{t.col2}</text>
		<text class="edge-sub" x="532" y="106" text-anchor="middle">{t.col3}</text>

		{/* 三行对比：左栏常驻，中栏与右栏随步点亮 */}
		{rows.map((row, i) => (
			<g>
				{/* 左栏：for 写法与传入的 Self 具体类型 */}
				<rect class="slot" x="16" y={row.y} width="164" height="64" rx="8"></rect>
				<text class="code" x="98" y={row.y + 26} text-anchor="middle">{row.code}</text>
				<text class="edge-sub" x="98" y={row.y + 48} text-anchor="middle">{row.selfType}</text>

				{/* 中栏 + 右栏：一步点亮 */}
				<g class="step" data-step={i + 1}>
					<path class="arrow" d={`M 180 ${row.y + 32} H 202`} marker-end="url(#ftm-head)"></path>

					{/* 中栏：匹配的标准库 impl IntoIterator */}
					<rect class="panel" x="202" y={row.y} width="224" height="64" rx="8"></rect>
					<text class="code" x="314" y={row.y + 26} text-anchor="middle">{row.implHead}</text>
					<text class="edge-sub" x="314" y={row.y + 48} text-anchor="middle">{row.itemLine}</text>

					<path class="arrow" d={`M 426 ${row.y + 32} H 448`} marker-end="url(#ftm-head)"></path>

					{/* 右栏：左边 s 的类型与原集合 names 的状态 */}
					<rect
						class={row.consumed ? 'freed' : 'object'}
						x="448"
						y={row.y}
						width="176"
						height="64"
						rx="8"
					></rect>
					<text class="code" x="536" y={row.y + 26} text-anchor="middle">{row.outType}</text>
					<text class="edge-sub" x="536" y={row.y + 48} text-anchor="middle">{row.state}</text>
				</g>
			</g>
		))}

		<defs>
			<marker id="ftm-head" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
				<path d="M0 0 L8 4 L0 8 Z" fill="var(--dg-line)"></path>
			</marker>
		</defs>
	</svg>

	<FigureControls controls="stepper" label={t.stepper} steps={t.steps} />
</figure>

<script>
	import { initFigures } from '../../scripts/motion';
	initFigures();
</script>
