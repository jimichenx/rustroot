---
/**
 * 4.1「读写排他：借用有效区间错开 vs 重叠（E0502）」。
 * 左栏：先读完 r（有效区间在最后一次使用处结束），再创建可变引用 m 修改 s，区间不重叠，编译通过。
 * 右栏：borrow-conflict.rs 取消 println!("{r}") 注释后，r 的共享借用区间延续到末尾，
 *       中间创建 m (&mut String) 索要排他访问，两段有效区间重叠，被 E0502 拦截。
 * 样式见 src/styles/diagrams.css。
 */
import { SITE_LOCALE } from '../../config/site';

const en = SITE_LOCALE === 'en';
const t = en
	? {
			caption:
				'Borrow validity spans are measured up to the last use. Finishing r before creating m leaves the spans disjoint; keeping r alive across m overlaps a shared borrow with an exclusive mutable borrow and triggers E0502.',
			title: 'Disjoint vs overlapping borrow spans on s',
			desc: 'Two panels compare borrow spans on local variable s: String. On the left, let r = &s is followed immediately by println!("{r}"), ending the shared borrow span; let m = &mut s and m.push_str("...") then run in a separate exclusive span, so the program compiles. On the right, println!("{r}") sits at the bottom, keeping the shared borrow r alive across let m = &mut s and m.push_str("..."); the dashed box highlights the overlap rejected by error[E0502].',
			okHead: 'disjoint spans · compiles',
			errHead: 'overlapping spans · E0502',
			shared: 'shared',
			exclusive: 'exclusive',
			okFoot1: 'r ends at last use, then m borrows s',
			okFoot2: 'borrow spans do not overlap',
			errFoot1: 'r is still live when m requests &mut s',
			errFoot2: 'overlap rejected with error[E0502]',
		}
	: {
			caption:
				'借用的有效区间算到最后一次使用处为止。先用完 r 再借出 m，两段区间错开即可通过编译；若 r 的使用跨越了 m，共享借用与排他可变借用重叠，编译器以 E0502 拦截。',
			title: '借用有效区间错开与重叠对比',
			desc: '左右两栏对比局部变量 s: String 上的借用有效区间。左栏在 let r = &s 后先执行 println!("{r}")，共享借用区间当场结束，随后 let m = &mut s 与 m.push_str("...") 独占修改 s，两段区间互不重叠，编译通过。右栏将 println!("{r}") 放在末尾，使共享借用 r 的有效区间一直延续到底部，与中间试图取得排他访问的 m（&mut String）纵向重叠，虚线框标出冲突区域，触发 error[E0502]。',
			okHead: '区间错开 · 编译通过',
			errHead: '区间重叠 · E0502 拦截',
			shared: '共享只读',
			exclusive: '独占可变',
			okFoot1: '先读完 r，再借出 m 修改 s',
			okFoot2: '两段有效区间互不重叠',
			errFoot1: 'r 仍将使用，m 却索要排他访问',
			errFoot2: '有效区间重叠，报 error[E0502]',
		};
---

<figure class="diagram">
	<figcaption>{t.caption}</figcaption>
	<svg viewBox="0 0 640 348" role="img" aria-labelledby="bc-title bc-desc">
		<title id="bc-title">{t.title}</title>
		<desc id="bc-desc">{t.desc}</desc>

		{/* 左面板：有效区间错开，编译通过 */}
		<rect class="panel" x="16" y="16" width="296" height="316" rx="12"></rect>
		<text class="label" x="32" y="44">{t.okHead}</text>

		<text class="code" x="32" y="90">{'let r = &s;'}</text>
		<text class="code" x="32" y="124">{'println!("{r}");'}</text>
		<text class="code" x="32" y="182">{'let m = &mut s;'}</text>
		<text class="code" x="32" y="216">{'m.push_str("...");'}</text>
		<text class="code" x="32" y="250">{'println!("{m}");'}</text>

		<rect class="slot" x="188" y="68" width="108" height="72" rx="8"></rect>
		<text class="code" x="242" y="98" text-anchor="middle">{'r: &String'}</text>
		<text class="edge-sub" x="242" y="122" text-anchor="middle">{t.shared}</text>

		<rect class="slot" x="188" y="160" width="108" height="106" rx="8"></rect>
		<text class="code" x="242" y="206" text-anchor="middle">{'m: &mut'}</text>
		<text class="edge-sub" x="242" y="230" text-anchor="middle">{t.exclusive}</text>

		<text class="edge-label" x="164" y="294" text-anchor="middle">{t.okFoot1}</text>
		<text class="edge-sub" x="164" y="316" text-anchor="middle">{t.okFoot2}</text>

		{/* 右面板：有效区间重叠，E0502 拦截 */}
		<rect class="panel" x="328" y="16" width="296" height="316" rx="12"></rect>
		<text class="label" x="344" y="44">{t.errHead}</text>

		<text class="code" x="344" y="90">{'let r = &s;'}</text>
		<text class="code" x="344" y="146">{'let m = &mut s;'}</text>
		<text class="code" x="344" y="188">{'m.push_str("...");'}</text>
		<text class="code" x="344" y="244">{'println!("{r}");'}</text>

		<rect class="slot" x="494" y="68" width="52" height="192" rx="8"></rect>
		<text class="code" x="520" y="156" text-anchor="middle">r</text>
		<text class="edge-sub" x="520" y="178" text-anchor="middle">{'&s'}</text>

		<rect class="freed" x="556" y="124" width="52" height="84" rx="8"></rect>
		<text class="code" x="582" y="156" text-anchor="middle">m</text>
		<text class="edge-sub" x="582" y="178" text-anchor="middle">{'&mut'}</text>

		<rect class="edge" x="488" y="118" width="126" height="96" rx="8"></rect>

		<text class="edge-label" x="476" y="294" text-anchor="middle">{t.errFoot1}</text>
		<text class="edge-sub" x="476" y="316" text-anchor="middle">{t.errFoot2}</text>
	</svg>
</figure>
