---
/**
 * 2.3「遮蔽之后新旧变量在栈帧上并存的布局」。
 * let s = String::from("hello"); let r = &s; let s = 7; 之后：
 * 旧 s（String）与新 s（i32）在栈帧上同时存在；
 * 名字 s 改指新变量，但引用 r 仍指向旧 s，堆上的 "hello" 仍由旧 s 负责、尚未释放。
 * 样式见 src/styles/diagrams.css。
 */
import { SITE_LOCALE } from '../../config/site';

const en = SITE_LOCALE === 'en';
const t = en
	? {
			caption:
				'After shadowing with let s = 7;: the old s (String) and new s (i32) coexist on the stack frame; the name s now resolves to the new variable, while r still points to the old s and "hello" on the heap remains alive.',
			title:
				'Stack and heap layout after shadowing s with let s = 7; while r borrows the old s',
			desc: 'On the stack frame, three variables coexist: at the top, r (&String) is one machine word holding the stack address of the old s, with a solid arrow pointing down to the old s. In the middle, the old s (String, shadowed but still valid) holds an active three-word header (ptr, len 5, cap 5) whose ptr arrow points to the active five-character buffer "hello" on the heap. At the bottom, the new s (i32, where the name s now resolves) holds 7 in an active slot. Nothing is freed.',
			stack: 'stack frame',
			heap: 'heap',
			addr: 'address of old s',
			pointsAt: 'points at old s',
			oldS: 'old s',
			oldSNote: '(shadowed, still valid)',
			newS: 'new s',
			newSNote: '(name s now resolves here)',
			buffer: 'character buffer',
			bufferSub: '(still owned by old s)',
			len: 'len · 5',
			cap: 'cap · 5',
		}
	: {
			caption:
				'执行 let s = 7; 遮蔽之后：旧 s（String）与新 s（i32）在栈帧上同时并存；名字 s 改指新变量，但引用 r 仍指向旧 s，堆上的 "hello" 并未当场释放。',
			title: '执行 let s = 7; 遮蔽之后的栈与堆布局',
			desc: '栈帧里三个变量同时并存：上方引用 r（&String）占一个机器字，存着旧 s 的栈地址，实线箭头向下指向旧 s；中间旧 s（String，被遮蔽但仍有效）占三个机器字（ptr、len · 5、cap · 5），ptr 向右画出实线箭头指向堆上仍有效的五个字符 "hello"；下方新 s（i32，当前名字 s 指向此处）占一个槽位，存放数值 7。整张图中没有任何变量或堆内存被释放。',
			stack: '栈帧',
			heap: '堆',
			addr: '旧 s 的栈地址',
			pointsAt: '指向旧 s',
			oldS: '旧 s',
			oldSNote: '（被遮蔽，但仍有效）',
			newS: '新 s',
			newSNote: '（当前名字 s 指向此处）',
			buffer: '字符缓冲区',
			bufferSub: '（仍由旧 s 负责释放）',
			len: 'len · 5',
			cap: 'cap · 5',
		};

const chars = ['h', 'e', 'l', 'l', 'o'];
---

<figure class="diagram">
	<figcaption>{t.caption}</figcaption>
	<svg viewBox="0 0 640 460" role="img" aria-labelledby="sc-title sc-desc">
		<title id="sc-title">{t.title}</title>
		<desc id="sc-desc">{t.desc}</desc>

		<rect class="panel" x="16" y="16" width="316" height="428" rx="12"></rect>
		<text class="label" x="36" y="42">
			{t.stack}
		</text>

		<text class="name" x="48" y="68">
			r
		</text>
		<text class="code" x="64" y="68">
			{'&String'}
		</text>
		<rect class="slot" x="48" y="78" width="252" height="40" rx="8"></rect>
		<text class="name" x="174" y="103" text-anchor="middle">
			{t.addr}
		</text>

		<path class="arrow" d="M174 118 V152" marker-end="url(#sc-head)"></path>
		<text class="edge-label" x="186" y="140">
			{t.pointsAt}
		</text>

		<rect class="panel" x="32" y="152" width="284" height="176" rx="10"></rect>
		<text class="name" x="48" y="176">
			{t.oldS}
		</text>
		<text class="code" x={en ? 94 : 86} y="176">
			String
		</text>
		<text class="label" x={en ? 148 : 138} y="176">
			{t.oldSNote}
		</text>

		<rect class="slot" x="48" y="188" width="252" height="36" rx="8"></rect>
		<text class="code" x="174" y="211" text-anchor="middle">
			ptr
		</text>

		<rect class="slot" x="48" y="232" width="252" height="36" rx="8"></rect>
		<text class="code" x="174" y="255" text-anchor="middle">
			{t.len}
		</text>

		<rect class="slot" x="48" y="276" width="252" height="36" rx="8"></rect>
		<text class="code" x="174" y="299" text-anchor="middle">
			{t.cap}
		</text>

		<text class="name" x="48" y="362">
			{t.newS}
		</text>
		<text class="code" x={en ? 98 : 86} y="362">
			i32
		</text>
		<text class="label" x={en ? 130 : 116} y="362">
			{t.newSNote}
		</text>
		<rect class="slot" x="48" y="374" width="252" height="40" rx="8"></rect>
		<text class="name" x="174" y="400" text-anchor="middle">
			7
		</text>

		<rect class="panel" x="360" y="16" width="264" height="428" rx="12"></rect>
		<text class="label" x="380" y="42">
			{t.heap}
		</text>

		<text class="label" x="380" y="148">
			{t.buffer}
		</text>
		<text class="label" x="380" y="168">
			{t.bufferSub}
		</text>
		<rect class="object" x="380" y="182" width="224" height="48" rx="10"></rect>
		{
			chars.map((ch, i) => (
				<g>
					<rect class="slot" x={392 + i * 42} y="190" width="34" height="32" rx="6"></rect>
					<text class="name" x={409 + i * 42} y="211" text-anchor="middle">
						{ch}
					</text>
				</g>
			))
		}

		<path class="arrow" d="M300 206 H380" marker-end="url(#sc-head)"></path>

		<defs>
			<marker id="sc-head" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
				<path d="M0 0 L8 4 L0 8 Z" fill="var(--dg-line)"></path>
			</marker>
		</defs>
	</svg>
</figure>
