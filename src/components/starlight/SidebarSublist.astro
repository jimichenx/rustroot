---
/**
 * 覆盖 Starlight 的 SidebarSublist（vendored 自 @astrojs/starlight 0.42.3 的
 * dist/components/SidebarSublist.astro，Icon 与 Badge 也一并内联——它们不在包导出里）。
 *
 * 相对原版的改动（数据标记由 src/config/sidebar.ts 写入条目 attrs）：
 *  1. 组内第一项带 data-chapter-page 的分组（章）：组标题渲染成指向章描述页的链接，
 *     子列表跳过该条目——章既是页面（点标题进入），又是目录（点箭头展开）。
 *     标题链接占满 summary 的非箭头区域：点链接只跳转并保证展开，不切换 details；
 *     文件末尾的脚本在捕获阶段截下这一击（Starlight 的 SidebarPersistState 会把
 *     summary 内的任何点击都记成一次切换，不截下它，点链接跳转后小组会被错误收起）。
 *     三角箭头不在链接里，仍走 <summary> 的原生切换与持久化。
 *  2. 带 data-part-page 的链接是篇扉页：字重和颜色轻于章标题，上方多留一截空。
 *
 * 升级 Starlight 后需对照新版原组件重新合并本文件。
 */
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro';

interface SidebarBadge {
	variant: 'note' | 'danger' | 'success' | 'caution' | 'tip' | 'default';
	class?: string;
	text?: string;
}

interface SidebarLinkEntry {
	type: 'link';
	label: string;
	href: string;
	isCurrent: boolean;
	badge?: SidebarBadge;
	attrs: Record<string, string | number | boolean | undefined | null>;
}

interface SidebarGroupEntry {
	type: 'group';
	label: string;
	entries: SidebarEntry[];
	collapsed?: boolean;
	badge?: SidebarBadge;
}

type SidebarEntry = SidebarLinkEntry | SidebarGroupEntry;

interface Props {
	sublist: SidebarEntry[];
	nested?: boolean;
}

const { sublist, nested } = Astro.props;

// 组内（含递归子组）是否有当前页，决定 <details> 是否展开。
const containsCurrent = (entries: SidebarEntry[]): boolean =>
	entries.some((entry) => (entry.type === 'link' ? entry.isCurrent : containsCurrent(entry.entries)));
---

<ul class:list={{ 'top-level': !nested }}>
	{
			sublist.map((entry) => {
			// 章组：第一项是章描述页（带 data-chapter-page 标记）。
			const chapterPage =
				entry.type === 'group' &&
				entry.entries[0]?.type === 'link' &&
				entry.entries[0].attrs?.['data-chapter-page']
					? entry.entries[0]
					: undefined;
			const children = chapterPage ? entry.entries.slice(1) : entry.entries;
			return (
				<li>
					{entry.type === 'link' ? (
						<a
							href={entry.href}
							aria-current={entry.isCurrent ? 'page' : undefined}
							class:list={[{ large: !nested }, entry.attrs.class]}
							{...entry.attrs}
						>
							<span>{entry.label}</span>
							{entry.badge && (
								<span class:list={['sl-badge', 'small', entry.badge.variant, entry.badge.class]}>
									{entry.badge.text}
								</span>
							)}
						</a>
					) : (
						<details
							open={containsCurrent(entry.entries) || !entry.collapsed}
							data-chapter-group={chapterPage ? true : undefined}
						>
							<summary>
								<span class="group-label">
									{chapterPage ? (
										<a
											class="group-link large"
											href={chapterPage.href}
											aria-current={chapterPage.isCurrent ? 'page' : undefined}
											data-chapter-link
										>
											{entry.label}
										</a>
									) : (
										<span class="large">{entry.label}</span>
									)}
									{entry.badge && (
										<span class:list={['sl-badge', 'small', entry.badge.variant, entry.badge.class]}>
											{entry.badge.text}
										</span>
									)}
								</span>
								<svg
									class="caret"
									width="16"
									height="16"
									viewBox="0 0 24 24"
									fill="currentColor"
									aria-hidden="true"
								>
									<path d="m14.83 11.29-4.24-4.24a1 1 0 1 0-1.42 1.41L12.71 12l-3.54 3.54a1 1 0 0 0 0 1.41 1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.24-4.24a1.002 1.002 0 0 0 0-1.42Z" />
								</svg>
							</summary>
							<SidebarRestorePoint />
							{children.length > 0 && <Astro.self sublist={children} nested />}
						</details>
					)}
				</li>
			);
		})
	}
</ul>

<style>
	@layer starlight.core {
		ul {
			--sl-sidebar-item-padding-inline: 0.5rem;
			list-style: none;
			padding: 0;
		}

		li {
			overflow-wrap: anywhere;
		}

		ul ul li {
			margin-inline-start: var(--sl-sidebar-item-padding-inline);
			border-inline-start: 1px solid var(--sl-color-hairline-light);
			padding-inline-start: var(--sl-sidebar-item-padding-inline);
		}

		.large {
			font-size: var(--sl-text-lg);
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.top-level > li + li {
			margin-top: 0.75rem;
		}

		/* 篇扉页：比章标题轻，并和上一组章隔开。当前页仍用下面的橙色高亮。 */
		.top-level > li:has(> a[data-part-page]) {
			margin-top: 1.35rem;
		}
		a.large[data-part-page]:not([aria-current='page']) {
			font-weight: 500;
			color: var(--sl-color-gray-2);
		}

		summary {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0.2em var(--sl-sidebar-item-padding-inline);
			line-height: 1.4;
			cursor: pointer;
			user-select: none;
		}
		summary::marker,
		summary::-webkit-details-marker {
			display: none;
		}

		.caret {
			width: 1.25rem;
			height: 1.25rem;
			transition: transform 0.2s ease-in-out;
			flex-shrink: 0;
		}
		:global([dir='rtl']) .caret {
			transform: rotateZ(180deg);
		}
		[open] > summary .caret {
			transform: rotateZ(90deg);
		}

		a {
			display: block;
			border-radius: 0.25rem;
			text-decoration: none;
			color: var(--sl-color-gray-2);
			padding: 0.3em var(--sl-sidebar-item-padding-inline);
			line-height: 1.4;
		}

		a:hover,
		a:focus {
			color: var(--sl-color-white);
		}

		[aria-current='page'],
		[aria-current='page']:hover,
		[aria-current='page']:focus {
			font-weight: 600;
			color: var(--sl-color-text-invert);
			background-color: var(--sl-color-text-accent);
		}

		a > *:not(:last-child),
		.group-label > *:not(:last-child) {
			margin-inline-end: 0.25em;
		}

		.group-label {
			flex: 1;
			min-width: 0;
		}

		/* 章组：标记在 <details> 上。summary 不自带内边距，整行除箭头外都是链接
		   （内边距落在链接上），点标题不会落进 summary 的原生切换区域。
		   若选择器写成 summary[data-chapter-group]，这层内边距去不掉，
		   标题会比普通分组（如「附录」）再缩进一截。 */
		details[data-chapter-group] > summary {
			padding: 0;
		}
		details[data-chapter-group] > summary .caret {
			margin-inline-end: var(--sl-sidebar-item-padding-inline);
		}

		/* 章组标题链接：内边距沿用通用 a 规则；悬停下划线标出「可以点进去」。 */
		.group-link {
			border-radius: 0.25rem;
		}
		.group-link:hover {
			text-decoration: underline;
			text-underline-offset: 0.2em;
		}

		@media (min-width: 50rem) {
			.top-level > li + li {
				margin-top: 0.5rem;
			}
			.large {
				font-size: var(--sl-text-base);
			}
			a {
				font-size: var(--sl-text-sm);
			}
		}
	}
</style>

<style>
	@layer starlight.components {
		/* 内联自 Starlight 的 Badge.astro（侧栏用到的子集） */
		:global(:root) {
			--sl-badge-default-border: var(--sl-color-accent);
			--sl-badge-default-bg: var(--sl-color-accent-low);
			--sl-badge-default-text: #fff;

			--sl-badge-note-border: var(--sl-color-blue);
			--sl-badge-note-bg: var(--sl-color-blue-low);
			--sl-badge-note-text: #fff;

			--sl-badge-danger-border: var(--sl-color-red);
			--sl-badge-danger-bg: var(--sl-color-red-low);
			--sl-badge-danger-text: #fff;

			--sl-badge-success-border: var(--sl-color-green);
			--sl-badge-success-bg: var(--sl-color-green-low);
			--sl-badge-success-text: #fff;

			--sl-badge-caution-border: var(--sl-color-orange);
			--sl-badge-caution-bg: var(--sl-color-orange-low);
			--sl-badge-caution-text: #fff;

			--sl-badge-tip-border: var(--sl-color-purple);
			--sl-badge-tip-bg: var(--sl-color-purple-low);
			--sl-badge-tip-text: #fff;
		}

		:global([data-theme='light']:root) {
			--sl-badge-default-bg: var(--sl-color-accent-high);
			--sl-badge-note-bg: var(--sl-color-blue-high);
			--sl-badge-danger-bg: var(--sl-color-red-high);
			--sl-badge-success-bg: var(--sl-color-green-high);
			--sl-badge-caution-bg: var(--sl-color-orange-high);
			--sl-badge-tip-bg: var(--sl-color-purple-high);
		}

		.sl-badge {
			display: inline-block;
			border: 1px solid var(--sl-color-border-badge);
			border-radius: 0.25rem;
			font-family: var(--sl-font-system-mono);
			line-height: normal;
			color: var(--sl-color-text-badge);
			background-color: var(--sl-color-bg-badge);
			overflow-wrap: anywhere;
		}

		/* Sidebar overrides */
		:global(.sidebar-content) .sl-badge {
			line-height: 1;
			font-size: var(--sl-text-xs);
			padding: 0.125rem 0.375rem;
		}

		/* outline variant */
		:global(.sidebar-content a[aria-current='page']) > .sl-badge {
			--sl-color-bg-badge: transparent;
			--sl-color-border-badge: currentColor;
			color: inherit;
		}

		/* Color variants */
		.default {
			--sl-color-bg-badge: var(--sl-badge-default-bg);
			--sl-color-border-badge: var(--sl-badge-default-border);
			--sl-color-text-badge: var(--sl-badge-default-text);
		}

		.note {
			--sl-color-bg-badge: var(--sl-badge-note-bg);
			--sl-color-border-badge: var(--sl-badge-note-border);
			--sl-color-text-badge: var(--sl-badge-note-text);
		}

		.danger {
			--sl-color-bg-badge: var(--sl-badge-danger-bg);
			--sl-color-border-badge: var(--sl-badge-danger-border);
			--sl-color-text-badge: var(--sl-badge-danger-text);
		}

		.success {
			--sl-color-bg-badge: var(--sl-badge-success-bg);
			--sl-color-border-badge: var(--sl-badge-success-border);
			--sl-color-text-badge: var(--sl-badge-success-text);
		}

		.tip {
			--sl-color-bg-badge: var(--sl-badge-tip-bg);
			--sl-color-border-badge: var(--sl-badge-tip-border);
			--sl-color-text-badge: var(--sl-badge-tip-text);
		}

		.caution {
			--sl-color-bg-badge: var(--sl-badge-caution-bg);
			--sl-color-border-badge: var(--sl-badge-caution-border);
			--sl-color-text-badge: var(--sl-badge-caution-text);
		}

		.small {
			font-size: var(--sl-text-xs);
			padding: 0.125rem 0.25rem;
		}
	}
</style>

<script>
	// 章组标题链接：点击只负责跳转，且目标组一定展开，绝不收起。
	// Starlight 的 SidebarPersistState 把 summary 内的任何点击都记成一次
	// 「展开/收起」（它不区分点的是链接还是箭头），跳转后按记录恢复，点链接
	// 就会把组错误收起。这里在捕获阶段截下链接点击：
	//   1. stopPropagation 让持久化监听器收不到这一击，不会写入翻转记录；
	//   2. 当场把 details 打开，并清掉该组已保存的收起状态——新页面渲染时
	//      本就因当前页在组内而默认展开，清除记录后恢复逻辑不再覆盖它。
	// 三角箭头不在链接内，继续走 <summary> 的原生切换和 Starlight 持久化。
	const STORAGE_KEY = 'sl-sidebar-state';

	document.addEventListener(
		'click',
		(event) => {
			if (!(event.target instanceof Element)) return;
			const link = event.target.closest('a[data-chapter-link]');
			if (!link) return;
			// 修饰点击（新标签页打开等）交给浏览器默认行为。
			if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
				return;
			}

			event.stopPropagation();

			const details = link.closest('details');
			if (details) details.open = true;

			try {
				const restore = details?.querySelector('sl-sidebar-restore');
				const rawIndex = restore?.getAttribute('data-index');
				const index = rawIndex === null || rawIndex === undefined ? NaN : Number(rawIndex);
				if (!Number.isNaN(index)) {
					const stored = JSON.parse(sessionStorage.getItem(STORAGE_KEY) ?? '{}');
					if (stored && Array.isArray(stored.open)) {
						delete stored.open[index];
						sessionStorage.setItem(STORAGE_KEY, JSON.stringify(stored));
					}
				}
			} catch {
				// 持久化只是渐进增强：sessionStorage 不可用时静默。
			}
		},
		true
	);
</script>
