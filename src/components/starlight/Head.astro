---
/**
 * 覆盖 Starlight 的 Head：在默认 <head> 之外补充跨域 SEO 元信息。
 *
 * - hreflang：告诉搜索引擎 rustroot.cn/<path> 与 rustroot.dev/<path> 是同一页面的不同语言版本
 * - x-default：默认指向国际站（英文）
 * - og:locale:alternate（og:locale 由 Starlight 默认输出）
 * - og:image：首页用 public/og/<lang>.png。正文写了 share 的页面用构建时
 *   生成的专属图（src/og/，写进 dist 的 /og/<slug>-<hash>.png）。
 *   Starlight 本身不输出 og:image，只能在这里补。
 * - 百度统计：只在中文构建写入 `<head>`。英文站不加载。
 * - Google 分析：只在英文构建写入 `<head>`。中文站不加载。
 *
 * 前提：两种语言的内容目录保持相同的相对路径。
 * 构建期通过 hasLivePage 检查对方语言是否已公开同一路径，仅为双侧都存在的页面输出互指 hreflang，
 * 避免中文连载阶段指向英文站 404 页触发搜索引擎告警。
 */
import Default from '@astrojs/starlight/components/Head.astro';
import { hasLivePage } from '../../config/release';
import { CURRENT, OTHER, REPOSITORY, X_DEFAULT_LOCALE, siteOrigin } from '../../config/site';
import { ogPublicPath } from '../../og/path';

const isDev = import.meta.env.DEV;
const isZh = CURRENT.code === 'zh';
const isEn = CURRENT.code === 'en';
const preview = new URL(CURRENT.site).hostname === 'preview.rustroot.cn';
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';

const currentOrigin = siteOrigin(CURRENT, isDev);
const currentHref = currentOrigin + pathname;
const otherHref = siteOrigin(OTHER, isDev) + pathname;
const xDefaultHref = siteOrigin(X_DEFAULT_LOCALE, isDev) + pathname;
const page = Astro.locals.starlightRoute?.entry;
const pageData = page?.data as { title?: string; share?: string } | undefined;
const share = pageData?.share?.trim() ?? '';
const pageTitle = pageData?.title?.trim() ?? '';
const ogImage =
	share && pageTitle && page
		? `${currentOrigin}${ogPublicPath({ slug: page.id, title: pageTitle, share })}`
		: `${currentOrigin}/og/${CURRENT.code}.png`;
const hasAlternate = hasLivePage(CURRENT.code, pathname) && hasLivePage(OTHER.code, pathname);

const homeJsonLd = isHome
	? JSON.stringify({
			'@context': 'https://schema.org',
			'@graph': [
				{
					'@type': 'WebSite',
					'@id': `${CURRENT.site}/#website`,
					url: `${CURRENT.site}/`,
					name: 'Rust Root',
					description: CURRENT.description,
					inLanguage: CURRENT.lang,
					publisher: {
						'@type': 'Person',
						name: 'jimichen',
						url: `${CURRENT.site}/about/author/`,
					},
				},
				{
					'@type': 'LearningResource',
					'@id': `${CURRENT.site}/#guide`,
					name: isZh
						? 'Rust Root · 从内存与类型理解 Rust 的开源指南'
						: 'Rust Root · Understand the principles behind Rust’s design',
					description: CURRENT.description,
					url: `${CURRENT.site}/`,
					inLanguage: CURRENT.lang,
					learningResourceType: 'Open Guide',
					educationalLevel: 'Intermediate',
					isAccessibleForFree: true,
					license: isZh
						? 'https://creativecommons.org/licenses/by-nc-nd/4.0/deed.zh-hans'
						: 'https://creativecommons.org/licenses/by-nc-nd/4.0/deed.en',
					author: {
						'@type': 'Person',
						name: 'jimichen',
						url: `${CURRENT.site}/about/author/`,
					},
					sameAs: [REPOSITORY],
					about: [
						{ '@type': 'Thing', name: 'Rust Programming Language' },
						{ '@type': 'Thing', name: 'Memory Management and Ownership' },
						{ '@type': 'Thing', name: 'Type System' },
					],
				},
			],
		})
	: undefined;

---

<Default><slot /></Default>

{/*
  大纲收起偏好。写在 head 里、正文绘制前，右栏第一次布局就是窄轨。
  键与 TableOfContents.astro 里的写入保持一致。
*/}
<script is:inline>
	try {
		if (
			document.documentElement.hasAttribute('data-has-toc') &&
			localStorage.getItem('rr-toc-collapsed') === '1'
		) {
			document.documentElement.setAttribute('data-toc-collapsed', '');
		}
	} catch {
		// 读不到偏好就保持展开。
	}
</script>

{
	preview ? (
		<meta name="robots" content="noindex, nofollow" />
	) : (
		<>
			{hasAlternate && (
				<>
					<link rel="alternate" hreflang={CURRENT.lang} href={currentHref} />
					<link rel="alternate" hreflang={OTHER.lang} href={otherHref} />
					<link rel="alternate" hreflang="x-default" href={xDefaultHref} />
					{/* Starlight 默认已输出 og:locale，这里只补充 alternate */}
					<meta property="og:locale:alternate" content={OTHER.lang} />
				</>
			)}
			{homeJsonLd && <script type="application/ld+json" set:html={homeJsonLd} />}
		</>
	)
}
{/* Starlight 完全不输出 og:image，分享图由这里提供 */}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content={ogImage} />
{
	isZh && !preview && (
		<script is:inline>
			var _hmt = _hmt || [];
			(function () {
				var hm = document.createElement('script');
				hm.src = 'https://hm.baidu.com/hm.js?a30192f3557171faa25cf09c4b35669c';
				var s = document.getElementsByTagName('script')[0];
				s.parentNode.insertBefore(hm, s);
			})();
		</script>
	)
}
{
	isEn && !preview && (
		<>
			<!-- Google tag (gtag.js) -->
			<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-PKCCM668ET"></script>
			<script is:inline>
				window.dataLayer = window.dataLayer || [];
				function gtag() {
					dataLayer.push(arguments);
				}
				gtag('js', new Date());
				gtag('config', 'G-PKCCM668ET');
			</script>
		</>
	)
}
