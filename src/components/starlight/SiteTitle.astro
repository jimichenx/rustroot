---
/**
 * 顶栏锁扣：截面 mark + 字标。
 *
 * mark 是「截面」（源文件 scripts/brand/logo/mark.svg）：圆角方块跟随主题文字色，
 * 一条锈橙切开面斜穿过下半。favicon 用同一几何，整枚锈橙、切开面挖空。
 *
 * 字标字母轮廓来自 Instrument Sans Bold（SIL Open Font License），
 * 只取轮廓，不附带字体文件。加了 mark 之后字标整体走文字色，
 * 橙色只留给 mark，避免一行里出现三处橙色。
 * 字标右侧的状态是「还在编写」，不是正式完成。
 */
import { CURRENT } from '../../config/site';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const isZh = CURRENT.code === 'zh';
const status = isZh ? '开发中' : 'In development';
const statusLabel = isZh ? `${siteTitle}，${status}` : `${siteTitle}, ${status}`;
---

