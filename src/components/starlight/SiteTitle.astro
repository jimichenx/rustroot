<style>
	.site-title {
		display: flex;
		align-items: center;
		gap: 9px;
		min-width: 0;
		text-decoration: none;
		color: var(--sl-color-white);
	}
	.mark {
		display: block;
		flex: none;
		height: 30px;
		width: 30px;
	}
	.wordmark {
		display: block;
		height: 26px;
		width: auto;
	}
	.status {
		flex: none;
		margin-inline-start: -1px;
		padding: 0.05em 0.45em 0.08em;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		font-weight: 500;
		line-height: 1.45;
		letter-spacing: 0.04em;
		white-space: nowrap;
	}
</style>
