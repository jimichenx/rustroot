---
/**
 * 13.4「Mutex 把数据关在里面，guard 的 Drop 放开锁」。
 *
 * 三步可跳：
 * 1. 不调用 lock，外部碰不到 Vec；
 * 2. 线程 A 拿到 MutexGuard，push(3)，B 与 C 排队；
 * 3. guard 离开作用域，Drop 放开锁，唤醒 B。
 *
 * 关掉 JS 时停在第 3 步。
 */
import { SITE_LOCALE } from '../../config/site';
import FigureControls from '../course/FigureControls.astro';

const copy = {
	zh: {
		caption:
			'Mutex<Vec<i32>> 把锁状态和 Vec 放在同一个值里。不调用 lock 就碰不到 Vec。lock 交出 MutexGuard，才能通过 DerefMut 修改。guard 离开作用域时 Drop 放开锁，并唤醒下一个线程。',
		title: 'guard 离开作用域时 Drop 放开 Mutex',
		desc: '第 1 步三个线程都在外面，Vec 在 Mutex 里面，外部碰不到。第 2 步线程 A 拿到 MutexGuard，通过 DerefMut 执行 push(3)，线程 B 与 C 排队，锁由 A 持有。第 3 步 guard 离开作用域，Drop 放开锁，线程 B 被唤醒，线程 C 仍在排队。',
		box: 'Mutex<Vec<i32>>',
		lockName: '锁状态',
		free: '未占用',
		held: 'A 持有',
		vecName: 'Vec<i32>',
		oldVals: '1 · 2',
		newVals: '1 · 2 · 3',
		noTouch: '外部碰不到',
		push: 'push(3)',
		outside: '在外面',
		holding: 'MutexGuard',
		dropped: '已 Drop',
		waiting: '排队',
		woken: '被唤醒',
		threads: ['线程 A', '线程 B', '线程 C'],
		notes: [
			'不调用 lock，外部碰不到里面的 Vec。',
			'不调用 lock，外部碰不到里面的 Vec。',
			'A 拿到 MutexGuard，通过 DerefMut 执行 push(3)。B 与 C 排队。',
			'guard 离开作用域，Drop 放开锁，唤醒 B。',
		],
		stepper: '从加锁到 Drop 解锁',
		steps: [
			'不调用 lock，碰不到 Vec',
			'A 持有 MutexGuard，B 与 C 排队',
			'Drop 放开锁，唤醒 B',
		],
	},
	en: {
		caption:
			'Mutex<Vec<i32>> keeps the lock state and the Vec in one value. Without lock the Vec is unreachable. lock hands back a MutexGuard, and DerefMut is how the Vec changes. When the guard leaves scope, Drop releases the lock and wakes the next thread.',
		title: 'Drop releases the Mutex when the guard leaves scope',
		desc: 'Step 1: three threads are outside. The Vec sits inside the Mutex and cannot be touched. Step 2: thread A holds a MutexGuard and push(3) runs through DerefMut. Threads B and C wait. The lock is held by A. Step 3: the guard leaves scope, Drop releases the lock, B is woken, and C is still waiting.',
		box: 'Mutex<Vec<i32>>',
		lockName: 'lock state',
		free: 'free',
		held: 'held by A',
		vecName: 'Vec<i32>',
		oldVals: '1 · 2',
		newVals: '1 · 2 · 3',
		noTouch: 'no access',
		push: 'push(3)',
		outside: 'outside',
		holding: 'MutexGuard',
		dropped: 'dropped',
		waiting: 'waiting',
		woken: 'woken',
		threads: ['thread A', 'thread B', 'thread C'],
		notes: [
			'Without lock, the Vec inside cannot be touched.',
			'Without lock, the Vec inside cannot be touched.',
			'A holds MutexGuard and push(3) runs. B and C wait.',
			'The guard leaves scope. Drop releases the lock and wakes B.',
		],
		stepper: 'From lock to Drop',
		steps: [
			'without lock, the Vec cannot be touched',
			'A holds the guard; B and C wait',
			'Drop releases the lock and wakes B',
		],
	},
} as const;

const locale = SITE_LOCALE === 'en' ? 'en' : 'zh';
const t = copy[locale];

const threads = [
	{ name: t.threads[0], x: 16 },
	{ name: t.threads[1], x: 226 },
	{ name: t.threads[2], x: 436 },
] as const;
---

<figure class="diagram mutex-guard-figure" data-stepper>
	<figcaption>{t.caption}</figcaption>
	<svg viewBox="0 0 640 376" role="img" aria-labelledby="mxg-title mxg-desc">
		<title id="mxg-title">{t.title}</title>
		<desc id="mxg-desc">{t.desc}</desc>

		<g class="mx-phase mx-a-out">
			<rect class="freed" x={threads[0].x} y="20" width="188" height="72" rx="8"></rect>
			<text class="name" x="110" y="48" text-anchor="middle">{threads[0].name}</text>
			<text class="edge-sub" x="110" y="70" text-anchor="middle">{t.outside}</text>
		</g>
		<g class="mx-phase mx-a-hold">
			<rect class="slot" x={threads[0].x} y="20" width="188" height="72" rx="8"></rect>
			<text class="name" x="110" y="48" text-anchor="middle">{threads[0].name}</text>
			<text class="code" x="110" y="70" text-anchor="middle">{t.holding}</text>
		</g>
		<g class="mx-phase mx-a-drop mx-end">
			<rect class="freed" x={threads[0].x} y="20" width="188" height="72" rx="8"></rect>
			<text class="name" x="110" y="48" text-anchor="middle">{threads[0].name}</text>
			<text class="edge-sub" x="110" y="70" text-anchor="middle">{t.dropped}</text>
		</g>

		<g class="mx-phase mx-b-out">
			<rect class="freed" x={threads[1].x} y="20" width="188" height="72" rx="8"></rect>
			<text class="name" x="320" y="48" text-anchor="middle">{threads[1].name}</text>
			<text class="edge-sub" x="320" y="70" text-anchor="middle">{t.outside}</text>
		</g>
		<g class="mx-phase mx-b-wait">
			<rect class="freed" x={threads[1].x} y="20" width="188" height="72" rx="8"></rect>
			<text class="name" x="320" y="48" text-anchor="middle">{threads[1].name}</text>
			<text class="edge-sub" x="320" y="70" text-anchor="middle">{t.waiting}</text>
		</g>
		<g class="mx-phase mx-b-wake mx-end">
			<rect class="slot" x={threads[1].x} y="20" width="188" height="72" rx="8"></rect>
			<text class="name" x="320" y="48" text-anchor="middle">{threads[1].name}</text>
			<text class="edge-sub" x="320" y="70" text-anchor="middle">{t.woken}</text>
		</g>

		<g class="mx-phase mx-c-out">
			<rect class="freed" x={threads[2].x} y="20" width="188" height="72" rx="8"></rect>
			<text class="name" x="530" y="48" text-anchor="middle">{threads[2].name}</text>
			<text class="edge-sub" x="530" y="70" text-anchor="middle">{t.outside}</text>
		</g>
		<g class="mx-phase mx-c-wait mx-end">
			<rect class="freed" x={threads[2].x} y="20" width="188" height="72" rx="8"></rect>
			<text class="name" x="530" y="48" text-anchor="middle">{threads[2].name}</text>
			<text class="edge-sub" x="530" y="70" text-anchor="middle">{t.waiting}</text>
		</g>

		<rect class="panel" x="80" y="112" width="480" height="168" rx="10"></rect>
		<text class="label" x="320" y="136" text-anchor="middle">{t.box}</text>

		<g class="mx-phase mx-lock-open mx-end">
			<rect class="slot" x="100" y="152" width="200" height="108" rx="8"></rect>
			<text class="edge-sub" x="200" y="186" text-anchor="middle">{t.lockName}</text>
			<text class="name" x="200" y="216" text-anchor="middle">{t.free}</text>
		</g>
		<g class="mx-phase mx-lock-held">
			<rect class="slot" x="100" y="152" width="200" height="108" rx="8"></rect>
			<text class="edge-sub" x="200" y="186" text-anchor="middle">{t.lockName}</text>
			<text class="name" x="200" y="216" text-anchor="middle">{t.held}</text>
		</g>

		<g class="mx-phase mx-vec-old">
			<rect class="object" x="320" y="152" width="220" height="108" rx="8"></rect>
			<text class="edge-sub" x="430" y="178" text-anchor="middle">{t.vecName}</text>
			<text class="code" x="430" y="206" text-anchor="middle">{t.oldVals}</text>
			<text class="edge-sub" x="430" y="232" text-anchor="middle">{t.noTouch}</text>
		</g>
		<g class="mx-phase mx-vec-new mx-end">
			<rect class="object" x="320" y="152" width="220" height="108" rx="8"></rect>
			<text class="edge-sub" x="430" y="178" text-anchor="middle">{t.vecName}</text>
			<text class="code" x="430" y="210" text-anchor="middle">{t.newVals}</text>
		</g>
		<text class="edge-label mx-phase mx-push" x="430" y="240" text-anchor="middle">{t.push}</text>

		<rect class="panel" x="16" y="300" width="608" height="56" rx="10"></rect>
		{
			t.notes.map((line, index) => (
				<text
					class:list={['edge-label', 'mx-only', `mx-only-${index}`, index === 3 && 'mx-end']}
					data-step={index === 0 ? undefined : index}
					x="320"
					y="334"
					text-anchor="middle"
				>
					{line}
				</text>
			))
		}
	</svg>
	<FigureControls controls="stepper" label={t.stepper} steps={[...t.steps]} />
</figure>

<script>
	import { initFigures } from '../../scripts/motion';
	initFigures();
</script>
