---
/**
 * 3.1「类型的两面：信息搬到了哪里」。
 * 上半：&i32 与 &mut i32 物理表示同为 8 字节地址，编译期约束相反；
 * rustc 核对后擦除，运行时只剩纯地址，目标整数没有对象头。
 * 下半：Python / Java 把类型指针、GC 与锁标记留在运行时对象头里。
 * 样式复用 src/styles/diagrams.css，不写组件内 <style>。
 */
import { SITE_LOCALE } from '../../config/site';

interface Props {
	lang?: 'zh' | 'en';
}

const copy = {
	zh: {
		caption:
			'&i32 与 &mut i32 同为 8 字节地址、约束相反，rustc 核对后擦除约束，运行时只剩纯地址和没有对象头的整数；Python / Java 则把类型指针与 GC、锁标记留在对象头里。',
		title: '相同的 8 字节地址，相反的编译期约束，擦除后没有对象头',
		desc: '左侧两张卡片是 &i32 与 &mut i32。两者的物理表示都是 8 字节地址；前者的约束是只读共享并实现 Copy，后者是独占修改且赋值即移动。两条实线箭头表示 rustc 在核对这些约束后将其擦除。右侧运行时，r1 与 m1 都只剩下 8 字节纯地址，并指向同一个 4 字节整数 7，内存里没有对象头，也没有权限标记位。底部对照里，Python / Java 的栈上引用指向堆对象：虚线框是 12～24 字节的对象头，里面放着类型指针、GC 与锁标记，实线框才是字段数据。',
		leftTitle: '编译期类型表（类型实体）',
		card1Type: '&i32',
		card2Type: '&mut i32',
		rep: '8B 地址',
		card1Rule: '只读 · Copy · 含有效区间',
		card2Rule: '独占写 · 移动 · 含有效区间',
		midKicker: 'rustc',
		midAction: '检查并擦除',
		midResult: '核对约束后擦除',
		rightTitle: '运行时内存（无对象头）',
		r1: 'r1: &i32',
		m1: 'm1: &mut i32',
		raw: '8B 纯地址',
		intLabel: '4B 整数 (7)',
		noHeader: '无对象头 · 无权限标记位',
		contrastTitle: '对比：Python / Java 运行时对象',
		stackName: '栈上引用',
		stackSub: '指向堆对象',
		headerName: '对象头 · 12～24B',
		headerSub: '类型指针 · GC / 锁标记',
		payloadName: '字段数据',
		payloadSub: '实际字段',
	},
	en: {
		caption:
			'&i32 and &mut i32 are both 8-byte addresses with opposite constraints; rustc checks and then erases those constraints, leaving a raw address and a header-free integer at runtime, while Python and Java keep a type pointer plus GC and lock flags in an object header.',
		title: 'Same 8-byte address, opposite compile-time constraints, no object header after erasure',
		desc: 'Two cards on the left are &i32 and &mut i32. Both are 8-byte addresses; &i32 is a shared read reference that implements Copy, and &mut i32 is an exclusive write reference that moves on assignment. Two solid arrows show rustc checking those constraints and then erasing them. At runtime, r1 and m1 are raw 8-byte addresses pointing at the same 4-byte integer 7, with no object header and no permission flag bits. The bottom strip contrasts a Python or Java stack reference pointing at a heap object: a dashed box is the 12–24 byte object header holding a type pointer, GC, and a lock flag, and a solid box is the field data.',
		leftTitle: 'Compile-time type table',
		card1Type: '&i32',
		card2Type: '&mut i32',
		rep: '8B addr',
		card1Rule: 'read · Copy · has span',
		card2Rule: 'write · Move · has span',
		midKicker: 'rustc',
		midAction: 'checks & erases',
		midResult: 'erased after check',
		rightTitle: 'Runtime memory (no header)',
		r1: 'r1: &i32',
		m1: 'm1: &mut i32',
		raw: '8B raw addr',
		intLabel: '4B int (7)',
		noHeader: 'no header · no flag bits',
		contrastTitle: 'Contrast: Python / Java runtime object',
		stackName: 'stack ref',
		stackSub: 'points at object',
		headerName: 'object header · 12–24B',
		headerSub: 'type ptr · GC / lock flag',
		payloadName: 'Payload',
		payloadSub: 'field bytes',
	},
} as const;

const { lang } = Astro.props;
const locale = lang ?? (SITE_LOCALE === 'en' ? 'en' : 'zh');
const t = copy[locale];
---

<figure class="diagram">
	<figcaption>{t.caption}</figcaption>
	<svg viewBox="0 0 640 448" role="img" aria-labelledby="te-title te-desc">
		<title id="te-title">{t.title}</title>
		<desc id="te-desc">{t.desc}</desc>

		{/* 背景：先画全部矩形 */}
		<rect class="panel" x="8" y="8" width="188" height="288" rx="10"></rect>
		<rect class="slot" x="20" y="48" width="164" height="100" rx="6"></rect>
		<rect class="slot" x="20" y="162" width="164" height="100" rx="6"></rect>

		<rect class="panel" x="340" y="8" width="292" height="288" rx="10"></rect>
		<rect class="slot" x="352" y="62" width="128" height="72" rx="6"></rect>
		<rect class="slot" x="352" y="176" width="128" height="72" rx="6"></rect>
		<rect class="object" x="504" y="128" width="116" height="80" rx="6"></rect>

		<rect class="panel" x="8" y="308" width="624" height="128" rx="10"></rect>
		<rect class="slot" x="24" y="352" width="136" height="68" rx="6"></rect>
		<rect class="freed" x="208" y="352" width="256" height="68" rx="6"></rect>
		<rect class="slot" x="472" y="352" width="144" height="68" rx="6"></rect>

		{/* 箭头：编译期卡片 → 运行时槽位，槽位 → 整数，栈引用 → 对象头 */}
		<path class="arrow" d="M 197 98 H 352" marker-end="url(#te-head)"></path>
		<path class="arrow" d="M 197 212 H 352" marker-end="url(#te-head)"></path>
		<path class="arrow" d="M 480 98 L 504 148" marker-end="url(#te-head)"></path>
		<path class="arrow" d="M 480 212 L 504 188" marker-end="url(#te-head)"></path>
		<path class="arrow" d="M 160 386 H 208" marker-end="url(#te-head)"></path>

		{/* 文字最后画，避免压住边框和箭头 */}
		<text class="edge-label" x="102" y="32" text-anchor="middle">{t.leftTitle}</text>
		<text class="code" x="102" y="74" text-anchor="middle">{t.card1Type}</text>
		<text class="code" x="102" y="98" text-anchor="middle">{t.rep}</text>
		<text class="edge-sub" x="102" y="124" text-anchor="middle">{t.card1Rule}</text>
		<text class="code" x="102" y="188" text-anchor="middle">{t.card2Type}</text>
		<text class="code" x="102" y="212" text-anchor="middle">{t.rep}</text>
		<text class="edge-sub" x="102" y="236" text-anchor="middle">{t.card2Rule}</text>

		<text class="edge-label" x="268" y="140" text-anchor="middle">{t.midKicker}</text>
		<text class="edge-label" x="268" y="162" text-anchor="middle">{t.midAction}</text>
		<text class="edge-sub" x="268" y="184" text-anchor="middle">{t.midResult}</text>

		<text class="edge-label" x="486" y="32" text-anchor="middle">{t.rightTitle}</text>
		<text class="code" x="416" y="88" text-anchor="middle">{t.r1}</text>
		<text class="code" x="416" y="112" text-anchor="middle">{t.raw}</text>
		<text class="code" x="416" y="202" text-anchor="middle">{t.m1}</text>
		<text class="code" x="416" y="226" text-anchor="middle">{t.raw}</text>
		<text class="code" x="562" y="172" text-anchor="middle">{t.intLabel}</text>
		<text class="edge-sub" x="486" y="276" text-anchor="middle">{t.noHeader}</text>

		<text class="edge-label" x="320" y="332" text-anchor="middle">{t.contrastTitle}</text>
		<text class="edge-label" x="92" y="376" text-anchor="middle">{t.stackName}</text>
		<text class="edge-sub" x="92" y="400" text-anchor="middle">{t.stackSub}</text>
		<text class="edge-label" x="336" y="376" text-anchor="middle">{t.headerName}</text>
		<text class="edge-sub" x="336" y="400" text-anchor="middle">{t.headerSub}</text>
		<text class="edge-label" x="544" y="376" text-anchor="middle">{t.payloadName}</text>
		<text class="edge-sub" x="544" y="400" text-anchor="middle">{t.payloadSub}</text>

		<defs>
			<marker id="te-head" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
				<path d="M0 0 L8 4 L0 8 Z" fill="var(--dg-line)"></path>
			</marker>
		</defs>
	</svg>
</figure>
