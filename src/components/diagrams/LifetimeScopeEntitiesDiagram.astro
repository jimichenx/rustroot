---
/**
 * 11.1「隐藏的范围参数与两个不同的 &i32 类型实体」。
 * 上栏左：源码表面，r_outer 与 r_inner 都写成 &i32。
 * 上栏右：编译器用 &(Scope, T) 填入不同范围，得到 &[1..10] i32 与 &[5..8] i32 两个类型实体。
 * 下栏：把内层短范围赋给外层 r_outer，范围盖不住，虚线箭头标出 E0597。
 * 样式复用 src/styles/diagrams.css，不写组件内 <style>。
 */
import { SITE_LOCALE } from '../../config/site';

interface Props {
	lang?: 'zh' | 'en';
}

const copy = {
	zh: {
		caption:
			'两处引用在源码里都写成 &i32，编译器却用 &(Scope, T) 填入不同范围，合成 r_outer 与 r_inner 两个类型实体；内层短范围赋给 r_outer 时范围不足，触发 E0597。',
		title: '表面同为 &i32，内部是两份范围不同的类型实体',
		desc: '上栏分成左右两列。左列是源码表面：外层变量 r_outer 与内层变量 r_inner 的写法都是 &i32，范围参数被省略。右列是编译器内部：&(Scope, T) 分别填入具体范围，r_outer 成为 &[1..10] i32（外层大范围），r_inner 成为 &[5..8] i32（内层小范围），两者是参数不同的独立类型实体。下栏是一次失败的赋值：&inner_val 只携带 [5..8]，写不进要求 [1..10] 的 r_outer，虚线箭头标出 error[E0597]: inner_val does not live long enough。',
		leftKicker: '源码表面',
		leftSub: '两处都写成 &i32',
		outerKind: '外层变量',
		outerSurface: 'r_outer: &i32',
		outerOmit: '省略了范围参数',
		innerKind: '内层变量',
		innerSurface: 'r_inner: &i32',
		innerOmit: '写法与上面相同',
		rightKicker: '编译器内部',
		rightSub: '&(Scope, T) 填入具体范围',
		fillLabel: '填入',
		outerName: 'r_outer',
		outerEntity: '&[1..10] i32',
		outerScope: '外层大范围 · 类型实体 A',
		innerName: 'r_inner',
		innerEntity: '&[5..8] i32',
		innerScope: '内层小范围 · 类型实体 B',
		blockKicker: '赋值被拦住',
		blockSub: '内层范围盖不住 r_outer 要求的范围',
		shortCode: '&inner_val',
		shortScope: '只有 [5..8]',
		blockArrow: 'E0597 · 范围不足',
		longCode: 'r_outer',
		longScope: '需要 [1..10]',
		errorCode: 'error[E0597]: inner_val does not live long enough',
	},
	en: {
		caption:
			'Both references are written &i32, but &(Scope, T) is filled with two different scopes, so r_outer and r_inner are distinct type entities. Assigning the shorter inner scope to r_outer fails with E0597.',
		title: 'Same &i32 on the surface, two different scope-filled type entities inside',
		desc: 'The upper row has two columns. On the left, the source text writes both the outer variable r_outer and the inner variable r_inner as &i32, with the scope parameter omitted. On the right, the compiler fills &(Scope, T): r_outer becomes &[1..10] i32 (the longer outer scope) and r_inner becomes &[5..8] i32 (the shorter inner scope), two distinct type entities. The lower row is a rejected assignment: &inner_val carries only [5..8] and cannot be stored in r_outer, which requires [1..10]. The dashed arrow marks error[E0597]: inner_val does not live long enough.',
		leftKicker: 'source text',
		leftSub: 'both written &i32',
		outerKind: 'outer variable',
		outerSurface: 'r_outer: &i32',
		outerOmit: 'scope param omitted',
		innerKind: 'inner variable',
		innerSurface: 'r_inner: &i32',
		innerOmit: 'same written form',
		rightKicker: 'inside the compiler',
		rightSub: '&(Scope, T) gets a scope',
		fillLabel: 'fills',
		outerName: 'r_outer',
		outerEntity: '&[1..10] i32',
		outerScope: 'type entity A · long scope',
		innerName: 'r_inner',
		innerEntity: '&[5..8] i32',
		innerScope: 'type entity B · short scope',
		blockKicker: 'assignment rejected',
		blockSub: 'the inner scope does not cover what r_outer requires',
		shortCode: '&inner_val',
		shortScope: 'only [5..8]',
		blockArrow: 'E0597 · too short',
		longCode: 'r_outer',
		longScope: 'needs [1..10]',
		errorCode: 'error[E0597]: inner_val does not live long enough',
	},
} as const;

const { lang } = Astro.props;
const locale = lang ?? (SITE_LOCALE === 'en' ? 'en' : 'zh');
const t = copy[locale];
---

<figure class="diagram">
	<figcaption>{t.caption}</figcaption>
	<svg viewBox="0 0 640 604" role="img" aria-labelledby="lse-title lse-desc">
		<title id="lse-title">{t.title}</title>
		<desc id="lse-desc">{t.desc}</desc>

		{/* 框在下，箭头居中，文字最后画，避免笔画压住标签 */}
		<rect class="panel" x="16" y="16" width="212" height="336" rx="10"></rect>
		<rect class="panel" x="292" y="16" width="332" height="336" rx="10"></rect>
		<rect class="slot" x="32" y="86" width="180" height="112" rx="6"></rect>
		<rect class="slot" x="32" y="214" width="180" height="112" rx="6"></rect>
		<rect class="object" x="308" y="86" width="300" height="112" rx="6"></rect>
		<rect class="object" x="308" y="214" width="300" height="112" rx="6"></rect>

		<rect class="panel" x="16" y="368" width="608" height="220" rx="10"></rect>
		<rect class="slot" x="32" y="442" width="176" height="96" rx="6"></rect>
		<rect class="object" x="432" y="442" width="176" height="96" rx="6"></rect>

		<path class="arrow" d="M 236 142 H 306" marker-end="url(#lse-head)"></path>
		<path class="arrow" d="M 236 270 H 306" marker-end="url(#lse-head)"></path>
		<path class="arrow danger" d="M 216 490 H 424" marker-end="url(#lse-head-muted)"></path>

		<text class="edge-label" x="32" y="42">{t.leftKicker}</text>
		<text class="edge-sub" x="32" y="64">{t.leftSub}</text>
		<text class="edge-sub" x="122" y="114" text-anchor="middle">{t.outerKind}</text>
		<text class="code" x="122" y="148" text-anchor="middle">{t.outerSurface}</text>
		<text class="edge-sub" x="122" y="178" text-anchor="middle">{t.outerOmit}</text>
		<text class="edge-sub" x="122" y="242" text-anchor="middle">{t.innerKind}</text>
		<text class="code" x="122" y="276" text-anchor="middle">{t.innerSurface}</text>
		<text class="edge-sub" x="122" y="306" text-anchor="middle">{t.innerOmit}</text>

		<text class="edge-label" x="308" y="42">{t.rightKicker}</text>
		<text class="edge-sub" x="308" y="64">{t.rightSub}</text>
		<text class="edge-label" x="260" y="126" text-anchor="middle">{t.fillLabel}</text>
		<text class="edge-label" x="260" y="254" text-anchor="middle">{t.fillLabel}</text>
		<text class="name" x="458" y="114" text-anchor="middle">{t.outerName}</text>
		<text class="code" x="458" y="148" text-anchor="middle">{t.outerEntity}</text>
		<text class="edge-sub" x="458" y="178" text-anchor="middle">{t.outerScope}</text>
		<text class="name" x="458" y="242" text-anchor="middle">{t.innerName}</text>
		<text class="code" x="458" y="276" text-anchor="middle">{t.innerEntity}</text>
		<text class="edge-sub" x="458" y="306" text-anchor="middle">{t.innerScope}</text>

		<text class="edge-label" x="32" y="396">{t.blockKicker}</text>
		<text class="edge-sub" x="32" y="418">{t.blockSub}</text>
		<text class="code" x="120" y="474" text-anchor="middle">{t.shortCode}</text>
		<text class="edge-sub" x="120" y="506" text-anchor="middle">{t.shortScope}</text>
		<text class="edge-label" x="320" y="472" text-anchor="middle">{t.blockArrow}</text>
		<text class="code" x="520" y="474" text-anchor="middle">{t.longCode}</text>
		<text class="edge-sub" x="520" y="506" text-anchor="middle">{t.longScope}</text>
		<text class="code" x="320" y="566" text-anchor="middle">{t.errorCode}</text>

		<defs>
			<marker id="lse-head" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
				<path d="M0 0 L8 4 L0 8 Z" fill="var(--dg-line)"></path>
			</marker>
			<marker id="lse-head-muted" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
				<path d="M0 0 L8 4 L0 8 Z" fill="var(--dg-line-muted)"></path>
			</marker>
		</defs>
	</svg>
</figure>
