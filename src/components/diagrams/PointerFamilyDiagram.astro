---
/**
 * 10.1「广义指针一分为三概念图」。
 * 顶层：物理层共性——广义物理指针（栈槽位存放目标内存地址：8B 瘦指针 / 16B 胖指针）。
 * 下层：按编译期安全契约与释放责任拆分为三列：
 *   ① 引用（Reference）：&T / &mut T —— 纯借用、借用检查器保护、内建 * 安全解引用
 *   ② 智能指针（Smart Pointer）：Box<T> / Rc<T> / Vec<T> / String —— 管理资源、实现 Deref + Drop
 *   ③ 裸指针（Raw Pointer）：*const T / *mut T —— 纯物理地址、剥离编译期检查、解引用需 unsafe
 * 样式复用 src/styles/diagrams.css，不写组件内 <style>。
 */
import { SITE_LOCALE } from '../../config/site';

interface Props {
	lang?: 'zh' | 'en';
}

const copy = {
	zh: {
		caption:
			'底层同为存放内存地址的广义物理指针（8B 瘦指针或 16B 胖指针），Rust 按「谁负责释放、受不受借用检查器保护、能否直接安全解引用」三条编译期边界，将它拆成引用、智能指针与裸指针三大家族。',
		title: '广义物理指针按编译期契约一分为三：引用、智能指针与裸指针',
		desc: '顶层面板展示物理层共性：广义物理指针（栈槽位存放目标内存地址），包含 8B 瘦指针（ptr）与 16B 胖指针（ptr + meta）。向下引出三条分支：前两条实线箭头挂载编译期安全契约，第三条虚线箭头剥离编译期安全检查。下方并排三列卡片：① 引用（Reference，&T / &mut T），纯借用无释放责任，受借用检查器（生命周期 \'a + 读写排他）保护，支持内建 * 直接安全解引用；② 智能指针（Smart Pointer，Box<T> / Rc<T> / Vec<T> / String），持有所有权或管理资源，实现 Drop 离开作用域自动清理，实现 Deref 支持 *p 与点号透明解引用；③ 裸指针（Raw Pointer，*const T / *mut T），无所有权且不自动清理，剥离全部编译期检查（可能为空或悬垂），解引用必须放进 unsafe 块。',
		topHead: '广义物理指针 · 栈槽位存放目标内存地址',
		thinChip: '8B 瘦指针 (ptr)',
		fatChip: '16B 胖指针 (ptr + meta)',
		branchSafe: '挂载编译期安全契约',
		branchRaw: '剥离编译期安全检查',
		col1Title: '① 引用',
		col1En: 'Reference',
		col1Types: '&T / &mut T',
		col1TypeSub: '8B 地址 / 16B 切片或虚表',
		col1Row1Title: '纯借用 · 无释放责任',
		col1Row1Sub: '离开作用域不释放目标',
		col1Row2Title: '借用检查器严格保护',
		col1Row2Sub: "生命周期 'a + 读写排他",
		col1Row3Title: '内建 * 直接安全解引用',
		col1Row3Sub: '100% 保证非空、对齐、有效',
		col2Title: '② 智能指针',
		col2En: 'Smart Pointer',
		col2Types1: 'Box<T> / Rc<T>',
		col2Types2: 'Vec<T> / String',
		col2Row1Title: '持有所有权 / 管理资源',
		col2Row1Sub: '实现 Drop 自动清理回收',
		col2Row2Title: '所有权与借用规则保护',
		col2Row2Sub: '编译期保证内部地址有效',
		col2Row3Title: '实现 Deref 透明解引用',
		col2Row3Sub: '*p 与 . 自动脱壳如普通引用',
		col3Title: '③ 裸指针',
		col3En: 'Raw Pointer',
		col3Types: '*const T / *mut T',
		col3TypeSub: '纯物理地址 · 无安全包装',
		col3Row1Title: '无所有权 · 不自动清理',
		col3Row1Sub: '离开作用域什么都不做',
		col3Row2Title: '剥离全部编译期检查',
		col3Row2Sub: '可能为空、未对齐或悬垂',
		col3Row3Title: '安全代码禁止直接 *p',
		col3Row3Sub: '解引用必须进 unsafe 块',
	},
	en: {
		caption:
			'All three share the same physical representation—an 8-byte thin pointer or 16-byte fat pointer holding a memory address. Rust splits them by compile-time contracts into references, smart pointers, and raw pointers.',
		title: 'Generalized physical pointer split by compile-time contracts into three families',
		desc: 'Top panel shows the shared physical representation: a generalized pointer storing a target memory address on the stack, either an 8B thin pointer (ptr) or a 16B fat pointer (ptr + meta). Three branches lead downward: two solid arrows with compile-time safety contracts and one dashed arrow with safety checks stripped. Bottom row shows three columns: 1. Reference (&T / &mut T), a pure borrow with no drop duty, guarded by the borrow checker (lifetime \'a + XOR aliasing), with built-in safe * dereference; 2. Smart Pointer (Box<T> / Rc<T> / Vec<T> / String), which owns or manages resources, implements Drop for automatic cleanup and Deref for transparent * and dot access; 3. Raw Pointer (*const T / *mut T), an unchecked physical address with no automatic cleanup, all static checks stripped (may be null or dangling), requiring an unsafe block to dereference.',
		topHead: 'Generalized Physical Pointer · Stack Slot Holds Target Address',
		thinChip: '8B thin pointer (ptr)',
		fatChip: '16B fat pointer (ptr + meta)',
		branchSafe: 'compile-time safety contracts',
		branchRaw: 'safety checks stripped',
		col1Title: '① Reference',
		col1En: 'Borrowing pointer',
		col1Types: '&T / &mut T',
		col1TypeSub: '8B addr / 16B slice or dyn',
		col1Row1Title: 'Pure borrow · no drop',
		col1Row1Sub: 'leaves target untouched',
		col1Row2Title: 'Borrow checker guarded',
		col1Row2Sub: "lifetime 'a + XOR aliasing",
		col1Row3Title: 'Built-in safe * deref',
		col1Row3Sub: 'always non-null & valid',
		col2Title: '② Smart Pointer',
		col2En: 'Resource-owning struct',
		col2Types1: 'Box<T> / Rc<T>',
		col2Types2: 'Vec<T> / String',
		col2Row1Title: 'Owns / manages resource',
		col2Row1Sub: 'impl Drop for auto cleanup',
		col2Row2Title: 'Ownership & borrow rules',
		col2Row2Sub: 'guarantees valid inner ptr',
		col2Row3Title: 'impl Deref transparent *',
		col2Row3Sub: '*p and . auto-coerce to &T',
		col3Title: '③ Raw Pointer',
		col3En: 'Unchecked address',
		col3Types: '*const T / *mut T',
		col3TypeSub: 'raw address · no wrapper',
		col3Row1Title: 'No ownership · no drop',
		col3Row1Sub: 'no cleanup on scope exit',
		col3Row2Title: 'Static checks stripped',
		col3Row2Sub: 'may be null or dangling',
		col3Row3Title: 'Direct *p forbidden',
		col3Row3Sub: 'deref requires unsafe {}',
	},
} as const;

const { lang } = Astro.props;
const locale = lang ?? (SITE_LOCALE === 'en' ? 'en' : 'zh');
const t = copy[locale];
---

<figure class="diagram">
	<figcaption>{t.caption}</figcaption>
	<svg viewBox="0 0 640 420" role="img" aria-labelledby="pf-title pf-desc">
		<title id="pf-title">{t.title}</title>
		<desc id="pf-desc">{t.desc}</desc>

		{/* 顶层：广义物理指针共性 */}
		<rect class="panel" x="64" y="14" width="512" height="84" rx="10"></rect>
		<text class="edge-label" x="320" y="36" text-anchor="middle">{t.topHead}</text>

		<rect class="slot" x="84" y="48" width="224" height="38" rx="6"></rect>
		<text class="code" x="196" y="72" text-anchor="middle">{t.thinChip}</text>

		<rect class="slot" x="332" y="48" width="224" height="38" rx="6"></rect>
		<text class="code" x="444" y="72" text-anchor="middle">{t.fatChip}</text>

		{/* 分叉箭头：前两支实线挂载编译期契约，第三支虚线剥离编译期检查 */}
		<text class="edge-sub" x="216" y="113" text-anchor="middle">{t.branchSafe}</text>
		<text class="edge-sub" x="424" y="113" text-anchor="middle">{t.branchRaw}</text>

		<path class="arrow" d="M 320 98 V 120 H 112 V 148" marker-end="url(#pf-head)"></path>
		<path class="arrow" d="M 320 98 V 148" marker-end="url(#pf-head)"></path>
		<path class="arrow danger" d="M 320 120 H 528 V 148" marker-end="url(#pf-head-muted)"></path>

		{/* 左列：① 引用（Reference） */}
		<rect class="panel" x="16" y="152" width="192" height="254" rx="10"></rect>
		<text class="edge-label" x="112" y="176" text-anchor="middle">{t.col1Title}</text>
		<text class="node-en" x="112" y="193" text-anchor="middle">{t.col1En}</text>

		<rect class="slot" x="28" y="204" width="168" height="46" rx="6"></rect>
		<text class="code" x="112" y="223" text-anchor="middle">{t.col1Types}</text>
		<text class="edge-sub" x="112" y="241" text-anchor="middle">{t.col1TypeSub}</text>

		<rect class="panel" x="28" y="260" width="168" height="40" rx="6"></rect>
		<text class="edge-label" x="112" y="276" text-anchor="middle">{t.col1Row1Title}</text>
		<text class="edge-sub" x="112" y="293" text-anchor="middle">{t.col1Row1Sub}</text>

		<rect class="panel" x="28" y="308" width="168" height="40" rx="6"></rect>
		<text class="edge-label" x="112" y="324" text-anchor="middle">{t.col1Row2Title}</text>
		<text class="edge-sub" x="112" y="341" text-anchor="middle">{t.col1Row2Sub}</text>

		<rect class="panel" x="28" y="356" width="168" height="40" rx="6"></rect>
		<text class="edge-label" x="112" y="372" text-anchor="middle">{t.col1Row3Title}</text>
		<text class="edge-sub" x="112" y="389" text-anchor="middle">{t.col1Row3Sub}</text>

		{/* 中列（主强调）：② 智能指针（Smart Pointer） */}
		<rect class="object" x="224" y="152" width="192" height="254" rx="10"></rect>
		<text class="edge-label" x="320" y="176" text-anchor="middle">{t.col2Title}</text>
		<text class="node-en" x="320" y="193" text-anchor="middle">{t.col2En}</text>

		<rect class="slot" x="236" y="204" width="168" height="46" rx="6"></rect>
		<text class="code" x="320" y="223" text-anchor="middle">{t.col2Types1}</text>
		<text class="code" x="320" y="241" text-anchor="middle">{t.col2Types2}</text>

		<rect class="panel" x="236" y="260" width="168" height="40" rx="6"></rect>
		<text class="edge-label" x="320" y="276" text-anchor="middle">{t.col2Row1Title}</text>
		<text class="edge-sub" x="320" y="293" text-anchor="middle">{t.col2Row1Sub}</text>

		<rect class="panel" x="236" y="308" width="168" height="40" rx="6"></rect>
		<text class="edge-label" x="320" y="324" text-anchor="middle">{t.col2Row2Title}</text>
		<text class="edge-sub" x="320" y="341" text-anchor="middle">{t.col2Row2Sub}</text>

		<rect class="panel" x="236" y="356" width="168" height="40" rx="6"></rect>
		<text class="edge-label" x="320" y="372" text-anchor="middle">{t.col2Row3Title}</text>
		<text class="edge-sub" x="320" y="389" text-anchor="middle">{t.col2Row3Sub}</text>

		{/* 右列：③ 裸指针（Raw Pointer） */}
		<rect class="panel" x="432" y="152" width="192" height="254" rx="10"></rect>
		<text class="edge-label" x="528" y="176" text-anchor="middle">{t.col3Title}</text>
		<text class="node-en" x="528" y="193" text-anchor="middle">{t.col3En}</text>

		<rect class="freed" x="444" y="204" width="168" height="46" rx="6"></rect>
		<text class="code" x="528" y="223" text-anchor="middle">{t.col3Types}</text>
		<text class="edge-sub" x="528" y="241" text-anchor="middle">{t.col3TypeSub}</text>

		<rect class="freed" x="444" y="260" width="168" height="40" rx="6"></rect>
		<text class="edge-label" x="528" y="276" text-anchor="middle">{t.col3Row1Title}</text>
		<text class="edge-sub" x="528" y="293" text-anchor="middle">{t.col3Row1Sub}</text>

		<rect class="freed" x="444" y="308" width="168" height="40" rx="6"></rect>
		<text class="edge-label" x="528" y="324" text-anchor="middle">{t.col3Row2Title}</text>
		<text class="edge-sub" x="528" y="341" text-anchor="middle">{t.col3Row2Sub}</text>

		<rect class="freed" x="444" y="356" width="168" height="40" rx="6"></rect>
		<text class="edge-label" x="528" y="372" text-anchor="middle">{t.col3Row3Title}</text>
		<text class="edge-sub" x="528" y="389" text-anchor="middle">{t.col3Row3Sub}</text>

		<defs>
			<marker id="pf-head" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
				<path d="M0 0 L8 4 L0 8 Z" fill="var(--dg-line)"></path>
			</marker>
			<marker id="pf-head-muted" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
				<path d="M0 0 L8 4 L0 8 Z" fill="var(--dg-line-muted)"></path>
			</marker>
		</defs>
	</svg>
</figure>
